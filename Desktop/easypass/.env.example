# SMTP Configuration for PHPMailer
# Copy this file to .env or set these environment variables in your system

# Mailer Driver (smtp, sendmail, mail)
MAILER=smtp

# SMTP Server Details (Example: Gmail)
# For Gmail, you might need an App Password if 2FA is on.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Options: tls or ssl
SMTP_SECURE=tls
SMTP_AUTH=true

# Credentials
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Sender Details
FROM_EMAIL=noreply@easypass.com
FROM_NAME="EasyPass Admin"

# Application Settings
# Default reminder days before expiry (can be overridden in Admin UI)
REMINDER_DEFAULT_DAYS=7
